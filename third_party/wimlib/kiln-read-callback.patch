+/* API function documented in wimlib.h (Kiln addition)  */
+WIMLIBAPI int
+wimlib_open_wim_from_reader(wimlib_read_func_t read_fn, void *ctx,
+			    uint64_t size, const tchar *name,
+			    int open_flags, WIMStruct **wim_ret,
+			    wimlib_progress_func_t progfunc, void *progctx)
+{
+	struct wim_reader_source src = { read_fn, ctx, size, name };
+
+	if (open_flags & ~(WIMLIB_OPEN_FLAG_CHECK_INTEGRITY |
+			   WIMLIB_OPEN_FLAG_ERROR_IF_SPLIT))
+		return WIMLIB_ERR_INVALID_PARAM;
+
+	if (!read_fn || !name || !*name || !wim_ret)
+		return WIMLIB_ERR_INVALID_PARAM;
+
+	return open_wim_as_WIMStruct(&src, open_flags | WIMLIB_OPEN_FLAG_FROM_READER,
+				     wim_ret, progfunc, progctx);
+}
