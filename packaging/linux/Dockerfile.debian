# Build image for the .deb (Debian 13; the package also installs on Ubuntu 26.04).
# GCC 14 has no C23 #embed (src: the Ventoy files), so C is compiled with clang-19.
FROM debian:trixie
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential clang-19 cmake ninja-build pkg-config patch file dpkg-dev qt6-base-dev \
      fdisk dosfstools mtools exfatprogs xz-utils libxml2-utils \
 && rm -rf /var/lib/apt/lists/*
